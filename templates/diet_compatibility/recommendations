

{% extends 'diet_compatibility/dashboard_layout.html' %}
{% load static %}

{% block title %}Health Recommendations{% endblock %}

{% block dashboard_content %}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-800 mb-2">
        <i class="fas fa-lightbulb text-yellow-500"></i> Personalized Health Recommendations
    </h1>
    <p class="text-gray-600">Based on your health profile, diseases, medicines, and lifestyle</p>
</div>

{% if recommendations %}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        {% for recommendation in recommendations %}
            <!-- Recommendation Card -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow">
                
                <!-- Color-coded Header -->
                <div class="{% if recommendation.priority == 'high' %}bg-gradient-to-r from-red-600 to-pink-600{% elif recommendation.priority == 'medium' %}bg-gradient-to-r from-yellow-500 to-orange-600{% else %}bg-gradient-to-r from-green-500 to-emerald-600{% endif %} p-6 text-white">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-2xl font-bold mb-2">{{ recommendation.title }}</h3>
                            <p class="text-white/80 text-sm">{{ recommendation.type }}</p>
                        </div>
                        <div class="text-4xl">{{ recommendation.icon }}</div>
                    </div>
                </div>

                <!-- Priority Badge -->
                <div class="px-6 pt-4">
                    <span class="inline-block {% if recommendation.priority == 'high' %}bg-red-100 text-red-700{% elif recommendation.priority == 'medium' %}bg-yellow-100 text-yellow-700{% else %}bg-green-100 text-green-700{% endif %} px-4 py-1 rounded-full text-xs font-bold">
                        {% if recommendation.priority == 'high' %}
                            🔴 High Priority
                        {% elif recommendation.priority == 'medium' %}
                            🟡 Medium Priority
                        {% else %}
                            🟢 Low Priority
                        {% endif %}
                    </span>
                </div>

                <!-- Content -->
                <div class="p-6">
                    <p class="text-gray-700 mb-4">{{ recommendation.description }}</p>

                    <!-- Action Based on Type -->
                    <div class="space-y-3 pt-4 border-t">
                        {% if recommendation.type == 'BMI' %}
                            <a href="{% url 'diet_compatibility:disease_diet' %}"
                               class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg font-semibold transition">
                                <i class="fas fa-apple-alt mr-2"></i>View Diet Suggestions
                            </a>
                        {% elif recommendation.type == 'Disease' %}
                            <a href="{% url 'diet_compatibility:disease_diet' %}?disease=1"
                               class="block w-full text-center bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg font-semibold transition">
                                <i class="fas fa-book mr-2"></i>Learn More
                            </a>
                        {% elif recommendation.type == 'Medicine' %}
                            <a href="{% url 'diet_compatibility:medicine_compatibility' %}"
                               class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg font-semibold transition">
                                <i class="fas fa-check-circle mr-2"></i>Check Interactions
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- General Tips -->
    <div class="mt-12 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-8 border-l-4 border-purple-600 shadow-lg">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">
            <i class="fas fa-heart text-red-600 mr-2"></i>General Health Tips
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition">
                <h4 class="text-lg font-bold text-gray-800 mb-3">
                    <i class="fas fa-dumbbell text-blue-600 mr-2"></i>Exercise
                </h4>
                <ul class="space-y-2 text-sm text-gray-700">
                    <li>• Aim for 150 minutes of moderate activity per week</li>
                    <li>• Include both cardio and strength training</li>
                    <li>• Consult doctor before starting new exercise</li>
                    <li>• Stay consistent and make it enjoyable</li>
                </ul>
            </div>

            <div class="bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition">
                <h4 class="text-lg font-bold text-gray-800 mb-3">
                    <i class="fas fa-moon text-indigo-600 mr-2"></i>Sleep
                </h4>
                <ul class="space-y-2 text-sm text-gray-700">
                    <li>• Get 7-9 hours of quality sleep</li>
                    <li>• Maintain consistent sleep schedule</li>
                    <li>• Avoid screens 1 hour before bed</li>
                    <li>• Create a cool, dark sleeping environment</li>
                </ul>
            </div>

            <div class="bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition">
                <h4 class="text-lg font-bold text-gray-800 mb-3">
                    <i class="fas fa-water text-cyan-600 mr-2"></i>Hydration
                </h4>
                <ul class="space-y-2 text-sm text-gray-700">
                    <li>• Drink at least 2-3 liters of water daily</li>
                    <li>• More if you exercise or live in hot climate</li>
                    <li>• Limit sugary and caffeinated drinks</li>
                    <li>• Monitor your urine color (pale = hydrated)</li>
                </ul>
            </div>

            <div class="bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition">
                <h4 class="text-lg font-bold text-gray-800 mb-3">
                    <i class="fas fa-brain text-purple-600 mr-2"></i>Stress Management
                </h4>
                <ul class="space-y-2 text-sm text-gray-700">
                    <li>• Practice meditation or yoga</li>
                    <li>• Spend time in nature</li>
                    <li>• Maintain work-life balance</li>
                    <li>• Talk to friends, family, or professionals</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="mt-12">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">
            <i class="fas fa-arrow-right text-green-600 mr-2"></i>Quick Actions
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <a href="{% url 'diet_compatibility:meal_plan' %}"
               class="bg-gradient-to-br from-green-500 to-emerald-600 text-white p-6 rounded-xl hover:shadow-lg transition text-center shadow-lg">
                <i class="fas fa-utensils text-3xl mb-3 block"></i>
                <p class="font-bold">Plan Meal</p>
                <p class="text-xs opacity-90">Create today's meal</p>
            </a>

            <a href="{% url 'diet_compatibility:calorie_counter' %}"
               class="bg-gradient-to-br from-orange-500 to-red-600 text-white p-6 rounded-xl hover:shadow-lg transition text-center shadow-lg">
                <i class="fas fa-fire text-3xl mb-3 block"></i>
                <p class="font-bold">Track Calories</p>
                <p class="text-xs opacity-90">Monitor intake</p>
            </a>

            <a href="{% url 'diet_compatibility:daily_log' %}"
               class="bg-gradient-to-br from-blue-500 to-cyan-600 text-white p-6 rounded-xl hover:shadow-lg transition text-center shadow-lg">
                <i class="fas fa-water text-3xl mb-3 block"></i>
                <p class="font-bold">Log Water</p>
                <p class="text-xs opacity-90">Stay hydrated</p>
            </a>

            <a href="{% url 'diet_compatibility:manage_allergies' %}"
               class="bg-gradient-to-br from-red-500 to-pink-600 text-white p-6 rounded-xl hover:shadow-lg transition text-center shadow-lg">
                <i class="fas fa-exclamation-circle text-3xl mb-3 block"></i>
                <p class="font-bold">Allergies</p>
                <p class="text-xs opacity-90">Update profile</p>
            </a>
        </div>
    </div>

{% else %}
    <!-- Empty State -->
    <div class="text-center py-16 bg-white rounded-xl shadow-lg">
        <i class="fas fa-star text-6xl text-gray-300 mb-4"></i>
        <h2 class="text-2xl font-bold text-gray-800 mb-2">No Recommendations Yet</h2>
        <p class="text-gray-600 mb-6">Complete your health profile to get personalized recommendations</p>
        <a href="{% url 'diet_compatibility:create_health_profile' %}"
           class="inline-block bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-bold transition">
            <i class="fas fa-user-plus mr-2"></i>Complete Profile
        </a>
    </div>
{% endif %}

{% endblock %}
